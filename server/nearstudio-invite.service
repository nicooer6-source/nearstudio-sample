[Unit]
Description=Nearstudio invitation access
After=network.target

[Service]
User=www-data
WorkingDirectory=/opt/nearstudio-invite
EnvironmentFile=/etc/nearstudio-invite.env
Environment=INVITE_DATA_DIR=/var/lib/nearstudio-invite
ExecStart=/usr/local/bin/node /opt/nearstudio-invite/invite.cjs
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/nearstudio-invite
UMask=0077

[Install]
WantedBy=multi-user.target
